{
  "name": "agent-lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent Lens — inspect Agent configuration and capabilities",
  "main": "dist/desktop/main.cjs",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.12.0 <27"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Agent-Deep-Lens/Agent-Lens.git"
  },
  "scripts": {
    "dev": "tsx packages/local-server/main.ts --dev",
    "start": "node dist/server/main.js",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop": "npm run build && electron .",
    "pack": "node scripts/package.mjs --dir",
    "dist": "node scripts/package.mjs",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:release": "node --test tests/release.test.mjs",
    "release:verify": "node scripts/release.mjs verify",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@iarna/toml": "^2.2.5",
    "chokidar": "^4.0.0",
    "fastify": "^5.0.0",
    "i18next": "^26.5.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.1.0",
    "react-markdown": "^10.0.0",
    "yaml": "^2.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  },
  "author": "Null Studio"
}
