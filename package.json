{
  "name": "agent-lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent Lens — inspect Agent configuration and capabilities",
  "main": "dist/desktop/main.cjs",
  "scripts": {
    "dev": "tsx packages/local-server/main.ts --dev",
    "start": "node dist/server/main.js",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@fastify/static": "^8.0.0",
    "chokidar": "^4.0.0",
    "fastify": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "yaml": "^2.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "studio.nullset.agent-tools-manager",
    "productName": "Agent Lens",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/web/**",
      "dist/desktop/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  },
  "author": "Null Studio"
}
